{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imageinfo.invalid/legacy-compatibility/coverage/audit.schema.v1.json",
  "title": "Bounded compatibility coverage trace, not acceptance",
  "type": "object",
  "required": [
    "schemaVersion",
    "ticket",
    "observedOn",
    "status",
    "authority",
    "referenceBaseline",
    "originalRequirements",
    "slices",
    "obligations",
    "surfaceTrace",
    "summary",
    "reverseOwners",
    "denominators",
    "currentNative",
    "evidenceSha256",
    "nativeHandleBoundary",
    "countingRule"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ticket": {
      "const": 141
    },
    "observedOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "const": "complete-audit-unmet-compatibility"
    },
    "authority": {
      "type": "object",
      "required": [
        "firstRawAcceptance",
        "fullParity",
        "dropInParity",
        "productionMutation",
        "storageProfileAdmission"
      ],
      "additionalProperties": false,
      "properties": {
        "firstRawAcceptance": {
          "const": false
        },
        "fullParity": {
          "const": false
        },
        "dropInParity": {
          "const": false
        },
        "productionMutation": {
          "const": false
        },
        "storageProfileAdmission": {
          "const": false
        }
      }
    },
    "referenceBaseline": {
      "type": "object"
    },
    "originalRequirements": {
      "type": "object",
      "minProperties": 18,
      "maxProperties": 18
    },
    "slices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "key",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "enum": [
              "original_lg",
              "original_gaps"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/row"
          },
          {
            "required": [
              "source",
              "text",
              "evidence",
              "original_requirement"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object"
              },
              "original_requirement": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "surfaceTrace": {
      "type": "object",
      "required": [
        "maps",
        "api_methods",
        "denominators",
        "current_native"
      ],
      "additionalProperties": false,
      "properties": {
        "maps": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "api_methods": {
          "type": "array",
          "minItems": 39,
          "maxItems": 39,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "current_native": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "denominators": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "expected_count",
              "ids",
              "entries"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "expected_count": {
                "type": "integer",
                "minimum": 1
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/row"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "originalLg",
        "originalGaps",
        "unmetClauses",
        "originalResidualCells",
        "residualRecordsAcrossOverlappingViews",
        "byClassification"
      ],
      "additionalProperties": false,
      "properties": {
        "originalLg": {
          "const": 6
        },
        "originalGaps": {
          "const": 12
        },
        "unmetClauses": {
          "const": 18
        },
        "originalResidualCells": {
          "type": "integer",
          "minimum": 1
        },
        "residualRecordsAcrossOverlappingViews": {
          "type": "integer",
          "minimum": 1
        },
        "byClassification": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reverseOwners": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "denominators": {
      "type": "object"
    },
    "currentNative": {
      "type": "object"
    },
    "evidenceSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nativeHandleBoundary": {
      "const": {
        "ticket": 140,
        "naturalWindowsCases": 7,
        "censoredWindowsCases": 1,
        "invalidAndClosedStdin": "EOF-observed-not-input-error",
        "writeOnlyStdin": "INPUT_IO-observed",
        "nullStdin": "watchdog-censored-no-natural-completion",
        "portableFailingHandleGuarantee": false,
        "muslReadonlyStdout": {
          "naturalStatus": 0,
          "capturedStdoutBytes": 0,
          "capturedStderrBytes": 0,
          "observedOutputIncomplete": false,
          "successfulDeliveryEstablished": false
        }
      }
    },
    "countingRule": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "residual": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "owner_tickets",
        "classification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "owner_tickets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "classification": {
          "enum": [
            "finite_current_work",
            "scope_definition",
            "permission_guarantee_decision",
            "conditional_alternative",
            "unknown_planner_scope",
            "eventual_0012"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "scope"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "owner_ticket": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "status",
        "residuals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "residuals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/residual"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
