{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imageinfo/imageinfo/raw/main/docs/legacy-compatibility/result.schema.json",
  "title": "Proposed imageinfo CLI result records and envelope v1",
  "description": "CLI request/file/summary records or complete JSON envelope; session control output is separate. Cross-record identity, counters, mode/state, precedence and authority require semantic validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/file"
    },
    {
      "$ref": "#/$defs/summary"
    },
    {
      "$ref": "#/$defs/envelope"
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "inputId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrenceRef": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "snapshotId": {
                  "$ref": "https://github.com/imageinfo/imageinfo/raw/main/docs/metadata-model/metadata-contract.schema.json#/$defs/id"
                },
                "occurrenceId": {
                  "$ref": "https://github.com/imageinfo/imageinfo/raw/main/docs/metadata-model/metadata-contract.schema.json#/$defs/id"
                }
              },
              "required": [
                "snapshotId",
                "occurrenceId"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "inputId",
        "path",
        "occurrenceRef"
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicationMayHaveOccurred": {
          "type": "boolean"
        },
        "changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanupPending": {
          "type": "boolean"
        },
        "recoveryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "publicationMayHaveOccurred",
        "changed",
        "cleanupPending",
        "recoveryIds",
        "notes"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "plan",
            "report",
            "extraction"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "retainedPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "committed",
            "failed-before-publish",
            "recovery-required"
          ]
        },
        "transactionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "retainedPath",
        "state",
        "transactionId",
        "recoveryIds"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "const": "request"
        },
        "operation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "read",
                "preview",
                "apply"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "operation",
        "mode",
        "issues"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "const": "file"
        },
        "inputId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "read",
            "previewed",
            "committed",
            "unchanged",
            "skipped-policy",
            "refused",
            "conflict",
            "failed",
            "failed-before-publish",
            "cancelled-before-publish",
            "unattempted",
            "recovered-original",
            "recovery-required"
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "https://github.com/imageinfo/imageinfo/raw/main/docs/metadata-model/metadata-contract.schema.json#/$defs/snapshot"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/datePreviewSnapshot"
            },
            {
              "$ref": "#/$defs/explicitPairSnapshot"
            }
          ]
        },
        "transactionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "issues": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "inputId",
        "path",
        "state",
        "snapshot",
        "transactionId",
        "effects",
        "issues"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "not": {
                  "const": "recovery-required"
                }
              }
            }
          },
          "then": {
            "properties": {
              "effects": {
                "properties": {
                  "changed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "const": "summary"
        },
        "exitStatus": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            130
          ]
        },
        "selectionComplete": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discovered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "excluded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deduplicated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byState": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "previewed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "committed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "unchanged": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "skipped-policy": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "refused": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "conflict": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "failed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "failed-before-publish": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "cancelled-before-publish": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "unattempted": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "recovered-original": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "recovery-required": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": []
            }
          },
          "required": [
            "discovered",
            "excluded",
            "deduplicated",
            "byState"
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "issues": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "interrupted": {
          "type": "boolean"
        },
        "outputComplete": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "exitStatus",
        "selectionComplete",
        "counts",
        "artifacts",
        "issues",
        "interrupted",
        "outputComplete"
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "files": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "request",
        "files",
        "summary"
      ]
    },
    "previewByteRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "offset",
        "length"
      ]
    },
    "previewAscii20": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 58
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 58
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 32
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 58
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 58
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "type": "integer",
          "minimum": 48,
          "maximum": 57
        },
        {
          "const": 0
        }
      ],
      "items": false
    },
    "previewFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/previewByteRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "range"
      ]
    },
    "datePreviewObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "previewed",
            "refused"
          ]
        },
        "field": {
          "const": "exif:DateTimeOriginal"
        },
        "source_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "allocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/previewByteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/previewAscii20"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_bytes": {
          "$ref": "#/$defs/previewAscii20"
        },
        "changed_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/previewByteRange"
          },
          "maxItems": 20
        },
        "preserved_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/previewByteRange"
          },
          "maxItems": 21
        },
        "changed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "preserved_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "value_already_matches": {
          "type": "boolean"
        },
        "field_shape_verified": {
          "type": "boolean"
        },
        "expected_occurrence_matches": {
          "type": "boolean"
        },
        "known_structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/previewFinding"
          }
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/previewFinding"
          }
        },
        "bytes_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "production_mutation_allowed": {
          "const": false
        }
      },
      "required": [
        "status",
        "field",
        "source_length",
        "allocation",
        "original_bytes",
        "proposed_bytes",
        "changed_ranges",
        "preserved_ranges",
        "changed_bytes",
        "preserved_bytes",
        "value_already_matches",
        "field_shape_verified",
        "expected_occurrence_matches",
        "known_structures",
        "refusals",
        "bytes_examined",
        "production_mutation_allowed"
      ]
    },
    "datePreviewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "date-preview"
        },
        "preview": {
          "$ref": "#/$defs/datePreviewObservation"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "preview"
      ]
    },
    "explicitPairSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "explicit-pair"
        },
        "pair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw_path": {
              "type": "string",
              "minLength": 1
            },
            "sidecar_path": {
              "type": "string",
              "minLength": 1
            },
            "association": {
              "const": "explicit_paths"
            }
          },
          "required": [
            "raw_path",
            "sidecar_path",
            "association"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "pair"
      ]
    }
  }
}
