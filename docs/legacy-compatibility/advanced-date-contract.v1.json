  "operations": [
    {
      "operation": "calendar-months",
      "requirement": "MAP-018",
      "destination": "One selected DTO civil value; intent only",
      "data": "Gregorian years 1..9999; no timezone needed",
      "coverage": "Integral month delta -120000..120000, same day/time; invalid end-day refuses",
      "refusal": "No clamping, AllDates expansion, implicit companion or CTMD edits",
      "nextCell": "Year/month/day and negative rollover authored vectors, then exact field-target model",
      "runtime": "unavailable"
    },
    {
      "operation": "elapsed-seconds",
      "requirement": "MAP-018",
      "destination": "One selected DTO and explicitly supplied fixed-offset context; intent only",
      "data": "Explicit +/-HH:MM offset; no host timezone",
      "coverage": "Integer seconds -86400..86400, preserve fixed-offset context",
      "refusal": "Zone-less input, leap second, range overflow or named-zone rules refuse",
      "nextCell": "Actual read-bound instant proposal with explicit offset occurrence and companion coverage",
      "runtime": "unavailable"
    },
    {
      "operation": "offset-convert",
      "requirement": "MAP-018",
      "destination": "One DTO plus named target offset proposal; intent only",
      "data": "Explicit source and target fixed offsets",
      "coverage": "Same instant: target civil = source civil + target offset - source offset",
      "refusal": "Unknown offset -00:00, missing offset and +/-14 beyond 14:00 refuse",
      "nextCell": "DTO/fraction/offset joint target contract with exact unchanged fraction",
      "runtime": "unavailable"
    },
    {
      "operation": "named-zone",
      "requirement": "MAP-018",
      "destination": "No destination proposal",
      "data": "No timezone database selected",
      "coverage": "No geographic zone, DST fold/gap or historical rule coverage",
      "refusal": "All named-zone conversion refuses; no host zone inference",
      "nextCell": "Pin lawful timezone data/version and gap/fold vectors before implementation",
      "runtime": "unavailable"
    },
    {
      "operation": "clock-correction",
      "requirement": "MAP-019",
      "destination": "UTC track-query time only; never change capture date",
      "data": "One or two caller-explicit camera/UTC integer-second anchors",
      "coverage": "One anchor constant correction within 86400 seconds; two anchors monotonic affine map inside <=86400-second span",
      "refusal": "No extrapolation with two anchors, fractional-second rounding, inferred zone or unsorted anchors",
      "nextCell": "Read-bound camera UTC plus exact rational correction and observed anchor provenance",
      "runtime": "unavailable"
    },
    {
      "operation": "track-interpolate",
      "requirement": "MAP-019",
      "destination": "Invented coordinate proposal only; no RAW or XMP write",
      "data": "Exactly two authored UTC/latitude/longitude samples; integer microdegrees",
      "coverage": "Ordered distinct UTC times, <=300-second gap, inclusive endpoints, linear coordinates",
      "refusal": "No extrapolation, antimeridian crossing, rounded fraction, speed/HDOP/altitude assumption",
      "nextCell": "Bounded track parser with rights, sample-quality and missing-zone/error vectors",
      "runtime": "unavailable"
    },
    {
      "operation": "geolocation",
      "requirement": "MAP-020",
      "destination": "Invented location label only; no GPS insertion",
      "data": "authored-rectangle-v1 offline only",
      "coverage": "Half-open rectangle [0,1000000) microdegrees on each axis => authored-cell-A",
      "refusal": "Unknown/missing database, outside coverage, online fallback or unsupported coordinate refuses",
      "nextCell": "Dataset manifest and lawful offline candidate with tie/distance/coverage fixtures",
      "runtime": "unavailable"
    },
    {
      "operation": "inverse-export",
      "requirement": "MAP-020",
      "destination": "No output/export file",
      "data": "No real data or track template selected",
      "coverage": "Neither location-label inverse lookup nor GPS-to-track export is specified as native behavior",
      "refusal": "No invented coordinate from label; no template/network fallback",
      "nextCell": "Separate exact named-location inverse ambiguity and GPS track export schema/escaping/rights vectors",
      "runtime": "unavailable"
    },
    {
      "operation": "validate",
      "requirement": "MAP-022",
      "destination": "Diagnostic only",
      "data": "One authored Gregorian DTO string",
      "coverage": "Shape/calendar only, not camera semantic consistency, checksum validity or repair",
      "refusal": "Suppression changes no validation outcome; unknown dependencies stay unknown",
      "nextCell": "Actual bounded native report classification against existing diagnostics",
      "runtime": "unavailable"
    },
    {
      "operation": "repair",
      "requirement": "MAP-022",
      "destination": "No destination or effects",
      "data": "No repair mapping, dependencies or storage profile qualified",
      "coverage": "Every repair/force/minor-error bypass request refuses",
      "refusal": "No guessed opaque/checksum repair, deletion, storage effects or diagnostic-to-authority conversion",
      "nextCell": "Exact named defect, old/new bytes, affected fields, independent semantic/preservation proof and qualified publication",
      "runtime": "unavailable"
    }
