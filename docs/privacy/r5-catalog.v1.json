  "occurrenceRules": {
    "select": "Match exact native namespace, ID and declared location, or exact XMP URI/local name and declared location; labels and prefixes are not selectors.",
    "repetitions": "Report every reached occurrence independently, including equal duplicates; retain source/document/path/ordinal identity.",
    "values": "Presence matches even if empty, invalid or zero; never interpret zero coordinates/serials as absence.",
    "absence": "Absent only for complete checked enumeration of the exact selector/location; unsupported, limited, opaque or unvisited locations are uninspectable.",
    "previews": "Each declared preview document is separate; enumerating preview bytes does not inspect its EXIF or XMP.",
    "xmp": "Match properties at any supported structural depth. Qualifier-only matches are residual diagnostics, not selected properties. Unsupported structures refuse complete coverage.",
    "canon0096": "Only the R5 Canon Main scalar branch is selected; SerialInfo subdirectories or an unverified variant remain uninspectable. Never wipe a whole maker-note block."
  },
