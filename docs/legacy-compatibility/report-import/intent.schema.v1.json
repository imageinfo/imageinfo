{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed data-only scalar intent batch v1; no application importer",
  "description": "Test-only contract. Companion semantic model enforces UTF-8 byte bounds, Unicode scalars, canonical u64/u32 ranges, nonzero denominator, duplicate targets and exact immutable observation-table matching. No loss acknowledgement or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "edits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "inert-scalar-intents"
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/edit"
      }
    }
  },
  "$defs": {
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKey",
        "snapshotId",
        "occurrenceId",
        "namespace",
        "nativeId",
        "operation",
        "value"
      ],
      "properties": {
        "sourceKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "occurrenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "const": "set"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decimal"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "decimal": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "numerator",
            "denominator"
          ],
          "properties": {
            "kind": {
              "const": "rational"
            },
            "numerator": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      ]
    }
  }
}
