  "vector_semantics": {
    "applied": "Hypothetical exact held-source no-replace success, not native evidence",
    "not-applied": "Hypothetical proven no-effect failure, not an arbitrary OS error",
    "unknown": "Affected source and destination bindings unknown; stop immediately",
    "denied-actor": "Assumed guard exclusion in model only; no native enforcement evidence",
    "foreign": "Create distinct foreign object in empty slot; preserve it",
    "stop": "No subsequent transition or compensating action",
    "verify": "Final guarded observation; matched needed for complete-observed",
    "bindings": "Last confirmed/observed symbolic map; after uncertainty this is not current namespace, identity preservation, custody or guard-continuity evidence"
